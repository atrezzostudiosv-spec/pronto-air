{
  "name": "pronto-air-assistant",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://atrezzostudiosv-spec.github.io"
  },
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "11001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
